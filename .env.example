POSTGRES_DB=campusconnect
POSTGRES_USER=campusconnect
POSTGRES_PASSWORD=campusconnect_dev_password
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/campusconnect
DB_USERNAME=campusconnect
DB_PASSWORD=campusconnect_dev_password

SERVER_PORT=8080

JWT_SECRET=replace_with_a_secure_base64_encoded_secret
JWT_EXPIRATION=86400000
# Comma-separated frontend URLs for local development or deployment
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Render provides PORT automatically; SERVER_PORT is the local fallback.

# Optional: create a university admin only if this email does not already exist.
# Set both values temporarily when starting the backend, then remove them.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional background sync for publicly published Google Sheets CSV
SHEET_SYNC_ENABLED=false
SHEET_CSV_URL=
SHEET_SOURCE=
SHEET_SYNC_INTERVAL_MS=1800000
